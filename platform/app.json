{
  "expo": {
    "name": "Footube",
    "slug": "Footube",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "footube",
    "ios": {
      "bundleIdentifier": "com.anonymous.Footube",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "childsafewallet"
        ]
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
