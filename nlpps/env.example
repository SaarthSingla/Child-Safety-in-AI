# Copy this file to .env (git ignores .env) and fill it in. `npm start` reads it.
#
# The LLM that reads parents' sentences. Groq has a free tier: get a key at
# console.groq.com. Any OpenAI-compatible service works.
# Provider: groq | ollama | custom
NLPPS_LLM_PROVIDER=groq
NLPPS_LLM_API_KEY=
# Optional: override the provider's default model.
# NLPPS_LLM_MODEL=
# Required only for NLPPS_LLM_PROVIDER=custom.
# NLPPS_LLM_BASE_URL=
